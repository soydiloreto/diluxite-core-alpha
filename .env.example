# --- Core (single-user, sin login) ---
PORT=3030
DATABASE_URL=postgres://diluxite:diluxite@localhost:5432/diluxite

# --- Embeddings: por default usa el provider determinista local (sin claves).
# Prioridad si están seteados: Azure OpenAI > Ollama local > determinista.

# Opción A — Azure OpenAI (máxima calidad, requiere las tres vars)
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=text-embedding-3-large
# EMBEDDING_DIMENSIONS=1536

# Opción B — Ollama local (sin claves, sin nube). Requiere modelo + dims.
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text       # 768 dims
# OLLAMA_EMBEDDING_DIMENSIONS=768
# OLLAMA_ENDPOINT=http://localhost:11434         # opcional
