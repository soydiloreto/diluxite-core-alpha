# --- Core (single-user, sin login) ---
PORT=3030
DATABASE_URL=postgres://diluxite:diluxite@localhost:5432/diluxite

# --- Embeddings: por default usa el provider determinista local (sin claves).
# Prioridad si están seteados: Azure OpenAI > Ollama local > determinista.

# Opción A — Azure OpenAI (máxima calidad, requiere las tres vars)
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=text-embedding-3-large
# EMBEDDING_DIMENSIONS=1536

# Opción B — Ollama local (sin claves, sin nube). Requiere modelo + dims.
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text       # 768 dims
# OLLAMA_EMBEDDING_DIMENSIONS=768
# OLLAMA_ENDPOINT=http://localhost:11434         # opcional

# --- Encryption at rest for stored credentials ---
# Needed only to save an embedding provider's API key from Admin → AI. Without
# it the console still configures Ollama and the local provider (neither has a
# key) and refuses to store one for Azure or Bedrock rather than writing it in
# the clear. Deliberately NOT randomly generated when absent: a random key
# would make every stored credential unreadable after the next restart.
# Falls back to DILUXITE_MFA_SIGNING_KEY / DILUXITE_CSRF_SIGNING_KEY.
# DILUXITE_SECRET_KEY=                            # >=16 chars, stable across restarts

# --- Server mode security secrets ---
# Stable server secrets. If unset they derive from DILUXITE_MFA_SIGNING_KEY /
# DILUXITE_ADMIN_PASSWORD, falling back to a per-process random value that
# rotates on restart (in-flight MFA / CSRF tokens invalidate after a deploy).
# Set these explicitly in production for stable behaviour.
# DILUXITE_MFA_SIGNING_KEY=                       # signs the password→TOTP handoff token (>=16 chars)
# DILUXITE_CSRF_SIGNING_KEY=                      # binds CSRF tokens to the session (>=16 chars)
