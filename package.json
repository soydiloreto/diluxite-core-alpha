{
  "name": "diluxite-core",
  "version": "1.0.0-alpha.62",
  "private": true,
  "description": "Diluxite Core \u2014 motor open source de la supermemoria para IA (notas + b\u00fasqueda sem\u00e1ntica + MCP)",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter @diluxite/api dev",
    "build": "pnpm -r build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "test": "vitest run",
    "test:unit": "vitest run --project core --project web --project api-unit",
    "test:int": "vitest run --project db --project api",
    "test:installer": "bash test/installer/run.sh",
    "test:watch": "vitest --project core",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/db/tsconfig.json && tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint . --max-warnings=0",
    "seed": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "bench": "tsx --env-file-if-exists=.env scripts/bench-search.ts",
    "ingest:ddw": "tsx --env-file-if-exists=.env scripts/ingest-ddw.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.11.0",
    "playwright": "^1.63.0",
    "postgres": "^3.4.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
