{
  "name": "diluxite-core",
  "version": "1.0.0-alpha.1",
  "private": true,
  "description": "Diluxite Core — motor open source de la supermemoria para IA (notas + búsqueda semántica + MCP)",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @diluxite/api dev",
    "build": "pnpm -r build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "test": "vitest run",
    "test:unit": "vitest run --project core --project web",
    "test:int": "vitest run --project db --project api",
    "test:watch": "vitest --project core",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/db/tsconfig.json && tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "seed": "tsx --env-file=.env scripts/seed-demo.ts"
  },
  "devDependencies": {
    "eslint": "^10.4.0",
    "playwright": "^1.60.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^3.0.5"
  }
}
