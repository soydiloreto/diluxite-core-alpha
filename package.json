{
  "name": "diluxite-core",
  "version": "1.0.0-alpha.56",
  "private": true,
  "description": "Diluxite Core — motor open source de la supermemoria para IA (notas + búsqueda semántica + MCP)",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @diluxite/api dev",
    "build": "pnpm -r build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "test": "vitest run",
    "test:unit": "vitest run --project core --project web --project api-unit",
    "test:int": "vitest run --project db --project api",
    "test:installer": "bash test/installer/run.sh",
    "test:watch": "vitest --project core",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/db/tsconfig.json && tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "seed": "tsx --env-file-if-exists=.env scripts/seed-demo.ts"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.0",
      "glob": "^11.1.0",
      "minimatch": "^10.2.3",
      "tar": "^7.5.11"
    }
  },
  "devDependencies": {
    "eslint": "^10.4.1",
    "playwright": "^1.60.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  }
}
