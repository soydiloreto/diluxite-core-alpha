#!/usr/bin/env bash
# Mock `docker` for the installer e2e suite. Simulates the compose lifecycle
# without touching a real daemon. Logs every call to $DOCKER_MOCK_LOG so tests
# can assert on behaviour (e.g. "did a config change pull images?").
[ -n "${DOCKER_MOCK_LOG:-}" ] && echo "docker $*" >> "${DOCKER_MOCK_LOG}"

case "${1:-}" in
  --version) echo "Docker version 99.0.0-mock, build deadbeef"; exit 0 ;;
  info)      exit 0 ;;
  run)       exit 0 ;;  # docker run --rm ... alpine tar ...  (caddy cert backup)
  ps)
    # `docker ps --format '{{.Names}}'` — used by mgmt_export_caddy_ca to
    # check that diluxite-caddy is running. Toggle via DLX_DOCKER_FAKE_CADDY.
    if [ "${DLX_DOCKER_FAKE_CADDY:-0}" = "1" ]; then
      echo "diluxite-caddy"
    fi
    exit 0 ;;
  exec)
    # docker exec [flags] <container> <cmd...> — scan the tail for the command.
    shift
    # Caddy local CA export (alpha.62): `docker exec diluxite-caddy cat
    # /data/caddy/pki/authorities/local/root.crt`. Returns a fake PEM.
    if printf '%s\n' "$@" | grep -q "pki/authorities/local/root.crt"; then
      cat <<'PEM'
-----BEGIN CERTIFICATE-----
MIIBkTCCATagAwIBAgIQEYahcXmEzPj0pifKkbZbATAKBggqhkjOPQQDAjAxMS8w
LQYDVQQDEyZDYWRkeSBMb2NhbCBBdXRob3JpdHkgLSAyMDI0IEVDQyBSb290MB4X
DTI0MDEwMTAwMDAwMFoXDTM0MDEwMTAwMDAwMFowMTEvMC0GA1UEAxMmQ2FkZHkg
TG9jYWwgQXV0aG9yaXR5IC0gMjAyNCBFQ0MgUm9vdDBZMBMGByqGSM49AgEGCCqG
SM49AwEHA0IABFKKp4qfPbAFKKp4qfPbAFKKp4qfPbAFKKp4qfPbAFKKp4qfPbAF
KKp4qfPbAFKKp4qfPbAFKKp4qfPbAFKKp4qfPbCjVjBUMA4GA1UdDwEB/wQEAwIB
hjATBgNVHSUEDDAKBggrBgEFBQcDATAPBgNVHRMBAf8EBTADAQH/MB0GA1UdDgQW
BBRMOCKDOC0KFOR4MOCKEDOFR0M3MDOCKD0wCgYIKoZIzj0EAwIDSAAwRQIhAMOCK
DOFRZTHIS0ISFAKEM4xS09l4iiv4iiiiv4ECIBHANDIWROTEITAOCKDOFR3VTM3MD
-----END CERTIFICATE-----
PEM
      exit 0
    fi
    for a in "$@"; do
      case "${a}" in
        pg_isready) exit 0 ;;
        pg_dump)    echo "-- mock pg_dump"; exit 0 ;;
      esac
    done
    # psql -tAc '<query>' — fake answers per query shape.
    if printf '%s\n' "$@" | grep -qi "from spaces"; then
      echo "sp-1|Local|local@diluxite|My space|0"        # un workspace para el seed
    elif printf '%s\n' "$@" | grep -qi "password_hash"; then
      echo "t"
    else
      echo "0"
    fi
    exit 0 ;;
  compose)
    shift
    sub=""
    while [ $# -gt 0 ]; do
      case "${1:-}" in
        --profile) shift 2; continue ;;
        -f|-p|--project-name) shift 2; continue ;;
        version|pull|up|down|ps|rm|stop|restart|exec) sub="$1"; break ;;
        *) shift ;;
      esac
    done
    case "${sub}" in
      version) exit 0 ;;
      ps)
        if printf '%s\n' "$@" | grep -q "json"; then
          echo '{"Name":"diluxite","Image":"soydiloreto/diluxite:next","Service":"diluxite","Status":"Up (healthy)","Ports":"0.0.0.0:5173->5173/tcp"}'
          echo '{"Name":"diluxite-db","Image":"pgvector/pgvector:pg17","Service":"db","Status":"Up (healthy)","Ports":"5432/tcp"}'
        else
          printf 'NAME      IMAGE          SERVICE   STATUS\n%s\n' "diluxite  diluxite:next  diluxite  Up (healthy)"
        fi
        exit 0 ;;
      *) exit 0 ;;
    esac ;;
  *) exit 0 ;;
esac
