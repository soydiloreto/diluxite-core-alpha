#!/usr/bin/env bash
# Mock `curl` for the installer e2e suite. Answers the few endpoints install.sh
# hits (app /api/info + /api/update/check, GitHub releases). Any -o download
# writes a placeholder. Everything else succeeds empty.
url=""; out=""; want_out=0
for a in "$@"; do
  if [ "${want_out}" = "1" ]; then out="${a}"; want_out=0; continue; fi
  case "${a}" in
    -o|--output) want_out=1 ;;
    http://*|https://*) url="${a}" ;;
  esac
done

case "${url}" in
  */api/info)
    echo '{"embedder":"deterministic","version":"1.0.0-alpha.48","authMode":"local","oidcEnabled":false,"user":{"email":"local@diluxite"}}' ;;
  */api/update/check)
    echo '{"current":"1.0.0-alpha.48","latest":"1.0.0-alpha.48","hasUpdate":false}' ;;
  *releases/latest)
    echo '{"tag_name":"v1.0.0-alpha.48"}' ;;
  *releases)
    echo '[{"tag_name":"v1.0.0-alpha.48"}]' ;;
  *)
    [ -n "${out}" ] && echo "mock" > "${out}" ;;
esac
exit 0
